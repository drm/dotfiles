#!/usr/bin/env bash

shopt -s nullglob globstar

typeit=0
if [[ $1 == "--type" ]]; then
	typeit=1
	shift
fi

if [[ -n $WAYLAND_DISPLAY ]]; then
	dmenu=dmenu-wl
	xdotool="ydotool type --file -"
elif [[ -n $DISPLAY ]]; then
	dmenu=dmenu
	xdotool="xdotool type --clearmodifiers --file -"
else
	echo "Error: No Wayland or X11 display detected" >&2
	exit 1
fi

stores=( "$HOME"/git/*/password-store )
if [[ ${#stores[@]} -eq 0 ]]; then
	echo "Error: no password stores in ~/git/*/password-store" >&2
	exit 1
elif [[ ${#stores[@]} -eq 1 ]]; then
	prefix=${stores[0]}
else
	names=( "${stores[@]%/password-store}" )
	names=( "${names[@]##*/}" )
	name=$(printf '%s\n' "${names[@]}" | "$dmenu" -p store "$@")
	[[ -n $name ]] || exit
	prefix=$HOME/git/$name/password-store
fi
export PASSWORD_STORE_DIR=$prefix

password_files=( "$prefix"/**/*.gpg )
password_files=( "${password_files[@]#"$prefix"/}" )
password_files=( "${password_files[@]%.gpg}" )

password=$(printf '%s\n' "${password_files[@]}" | "$dmenu" -p pass "$@")

[[ -n $password ]] || exit

if [[ $typeit -eq 0 ]]; then
	pass show -c "$password" 2>/dev/null
else
	pass show "$password" | { IFS= read -r pass; printf %s "$pass"; } | $xdotool
fi
